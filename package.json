{
  "name": "lia-forge-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "electron .",
    "postinstall": "install-electron",
    "test": "node tests/mcp-smoke.mjs && node tests/vite-store-smoke.mjs && node tests/comfyui-client-smoke.mjs && node tests/task-manager-smoke.cjs && node tests/navigation-guard-smoke.cjs && node tests/manual-artifacts-smoke.cjs && node tests/external-tools-smoke.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:win:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.liaforge.studio",
    "productName": "Lia Forge",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/comfyui-client.mjs",
      "workflows/comfyui/**/*",
      "assets/lia-forge.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/lia-forge.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lia Forge"
    }
  }
}
